# ============================================
# Supabase
# ============================================
# URL pública de tu proyecto Supabase
PUBLIC_SUPABASE_URL=
# Clave pública (anon) de tu proyecto Supabase
PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (solo se usa de forma segura en el lado del servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Tiempo de expiración de la sesión en segundos (por defecto 3600)
SESSION_REFRESH_INTERVAL=3600

# ============================================
# Geolocalización (autocompletado de dirección)
# ============================================
# URL base de la API de geolocalización (por defecto Nominatim/OpenStreetMap)
GEOCODING_API_URL=https://nominatim.openstreetmap.org
# User-Agent requerido por los términos de uso de Nominatim
GEOCODING_USER_AGENT=logistic-app
